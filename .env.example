# --- Cloud Run / runtime ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO

# --- Auth (Google OAuth) ---
# Comma-separated list of email domains permitted to log in.
ALLOWED_EMAIL_DOMAINS=devoteam.com,devoteam.sa
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public callback URL Cloud Run sees, e.g. https://vm-sheet-transformer-xxx.a.run.app/auth/callback
OAUTH_REDIRECT_URL=
# Long random string used to sign session cookies. Rotate periodically.
SESSION_SECRET=change-me

# Set to "true" only in local development to bypass OAuth entirely.
DEV_AUTH_BYPASS=false

# --- Uploads ---
MAX_UPLOAD_MB=25
# Background eviction window for /tmp uploads.
UPLOAD_RETENTION_MINUTES=60

# --- Optional: persist uploads to GCS ---
ENABLE_GCS_STORAGE=false
GCS_BUCKET_NAME=

# --- Frontend hand-off ---
# Path the FastAPI process serves the SPA from. The Dockerfile sets this to
# /app/frontend/dist; change only if running outside the container.
FRONTEND_DIST_DIR=frontend/dist
